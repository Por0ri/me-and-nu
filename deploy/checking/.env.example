# Copy only for the isolated backend-checking environment. Never use deploy/.env.
# Prefer: python3 deploy/checking/validate.py init --image-tag <full-Git-SHA>
CHECKING_IMAGE_TAG=
CHECKING_CAROUSEL_TEST_PREVIEW_ENABLED=false
CHECKING_POSTGRES_PASSWORD=
CHECKING_REDIS_PASSWORD=
CHECKING_FORWARDED_ALLOW_IPS=127.0.0.1
CHECKING_KAKAO_OAUTH_ENABLED=false
CHECKING_KAKAO_CLIENT_ID=
CHECKING_KAKAO_CLIENT_SECRET=
CHECKING_NAVER_OAUTH_ENABLED=false
CHECKING_NAVER_CLIENT_ID=
CHECKING_NAVER_CLIENT_SECRET=
# Chatbot answers only (API container). Empty keeps them off; put the real key only in the server file.
CHECKING_LLM_KEY=
# Chatbot dictionary only (API container): postgresql+psycopg://menu_dict_reader:<own 64-hex password>@postgres:5432/menu_dict
# Empty keeps it off. See the chatbot dictionary section in deploy/checking/README.md.
CHECKING_DICT_DATABASE_URL=
# All users' chatbot questions per day (1-999999), counted together with the main API; keep MAIN_CHAT_DAILY_TOTAL_LIMIT equal.
CHECKING_CHAT_DAILY_TOTAL_LIMIT=100
