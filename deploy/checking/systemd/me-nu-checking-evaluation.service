[Unit]
Description=Checking recommendation evaluation pipeline
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/apps/me-nu-checking
ExecStart=/usr/bin/python3 /home/ubuntu/apps/me-nu-checking/deploy/checking/run_evaluation_pipeline.py --observation-days 7 --min-samples 20
UMask=0077
Nice=10
TimeoutStartSec=15min
KillSignal=SIGTERM
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=me-nu-checking-evaluation
