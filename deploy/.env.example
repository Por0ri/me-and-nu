# Copy to deploy/.env and use it explicitly:
# docker compose --env-file deploy/.env -f compose.deploy.yaml config --quiet
# The real deploy/.env is ignored by Git and never copied into the API image.
COMPOSE_PROJECT_NAME=me-nu-deploy
BACKEND_IMAGE=me-nu-backend:staging
API_PORT=8000

# Separate deployment volumes are created; local DB data is not imported.
# User/database names: use letters, digits, and underscores.
POSTGRES_USER=me_nu
POSTGRES_DB=me_nu

# Required: generate TWO different 64-character hex passwords.
# Run twice: python -c "import secrets; print(secrets.token_hex(32))"
# Use hex only: Compose also embeds each password into a connection URL.
# Blank values intentionally prevent Compose from starting.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Actual frontend origin(s), separated by commas, without a trailing slash.
# Replace this example after choosing the team-test domain.
FRONTEND_ORIGINS=https://test.example.com

# Trust only the HTTPS proxy address seen by the API container.
# A proxy on the Docker host may appear as the bridge gateway, not 127.0.0.1.
# Leave this default until the reverse proxy is configured; do not use '*'.
FORWARDED_ALLOW_IPS=127.0.0.1

REDIS_KEY_PREFIX=me_nu_staging
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_MAX_CONNECTIONS=20
REDIS_MAXMEMORY=128mb
SESSION_COOKIE_NAME=menu_staging_session
SESSION_EXPIRE_MINUTES=30

# Optional external integrations; not needed for API/DB/Redis health checks.
TMDB_KEY=
LLM_KEY=

# compose.deploy.yaml fixes these deployment settings:
# SESSION_BACKEND=redis, SESSION_COOKIE_SECURE=true, DATABASE_ECHO=false,
# ENABLE_DEV_API=false, ENABLE_DEV_AUTH_BYPASS=false.
# DATABASE_URL and REDIS_URL are built from the credentials above using the
# internal service names postgres:5432 and redis:6379 (never localhost).
