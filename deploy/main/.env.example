# Main API candidate inputs plus readiness declarations; never auto-loaded.
# Copy to ignored deploy/main/.env on the server only after release review.
# Reuse the existing Checking DB/Redis credentials; never create replacement data stores.
MAIN_IMAGE_TAG=
MAIN_DATA_STRATEGY=reuse_checking
MAIN_TARGET_DATABASE=me_nu_checking
MAIN_EVENT_DATA_SOURCE=local_demo
MAIN_POSTGRES_PASSWORD=
MAIN_REDIS_PASSWORD=
MAIN_FORWARDED_ALLOW_IPS=127.0.0.1
MAIN_KAKAO_OAUTH_ENABLED=false
MAIN_KAKAO_CLIENT_ID=
MAIN_KAKAO_CLIENT_SECRET=
MAIN_NAVER_OAUTH_ENABLED=false
MAIN_NAVER_CLIENT_ID=
MAIN_NAVER_CLIENT_SECRET=
# Chatbot only (empty keeps answers off). Copy the Checking values inside the server; never print them.
# Dictionary: postgresql+psycopg://menu_dict_reader:<64 hex>@postgres:5432/menu_dict (shared with Checking).
MAIN_LLM_KEY=
MAIN_DICT_DATABASE_URL=
# All users' chatbot questions per day (1-999999), counted together with Checking; keep CHECKING_CHAT_DAILY_TOTAL_LIMIT equal.
MAIN_CHAT_DAILY_TOTAL_LIMIT=100
# Optional for older Main manifests; defaults preserve the backend's disabled debate feature.
MAIN_DEBATE_ENABLED=false
MAIN_DEBATE_VOTE_THRESHOLD=10
MAIN_BACKUP_VERIFIED=false
MAIN_DATA_PARITY_VERIFIED=false
MAIN_DB_CAPACITY_VERIFIED=false
MAIN_DNS_TLS_VERIFIED=false
MAIN_OAUTH_CALLBACKS_VERIFIED=false
MAIN_FRONTEND_BUILD_VERIFIED=false
MAIN_RELEASE_APPROVED=false

MENU_DEPLOYMENT_ENV=production
FRONTEND_ORIGINS=https://www.me-nu.kr,https://api.me-nu.kr
OAUTH_FRONTEND_ORIGIN=https://www.me-nu.kr
OAUTH_PUBLIC_API_ORIGIN=https://api.me-nu.kr
SESSION_BACKEND=redis
SESSION_COOKIE_NAME=menu_main_session
SESSION_COOKIE_SECURE=true
REDIS_KEY_PREFIX=me_nu_main
ENABLE_DEV_API=false
ENABLE_DEV_AUTH_BYPASS=false
CHECKING_CAROUSEL_TEST_PREVIEW_ENABLED=false

# Recorded intent, not live worker switches or an implemented daily scheduler.
MAIN_PLAN_AUTO_COLLECTION_ENABLED=false
MAIN_PLAN_PAID_GENERATION_ENABLED=false
DAILY_APPROVED_CONTENT_TARGET=20
GENERATION_TIMEZONE=Asia/Seoul
MAX_GENERATION_ATTEMPTS_PER_DAY=
GENERATION_DAILY_BUDGET_USD=
GENERATION_ENDS_AT=
