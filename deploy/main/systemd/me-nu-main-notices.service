[Unit]
Description=Publish due Main notices and in-app deliveries
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/apps/me-nu-main-20261118
ExecStart=/usr/bin/python3 /home/ubuntu/apps/me-nu-main-20261118/deploy/main/main_notices.py run
UMask=0077
Nice=10
TimeoutStartSec=5min
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=me-nu-main-notices
