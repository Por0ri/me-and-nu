[Unit]
Description=Read-only generation dashboard snapshot
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
# Replace this immutable release path when deploying the reviewed exporter.
ExecStart=/usr/bin/python3 /home/ubuntu/apps/REVIEWED_RELEASE/deploy/generation-observability/export_snapshot.py --output-directory /home/ubuntu/me-nu-generation-observability
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/me-nu-generation-observability
