# RAG형 단독 실행용. 이 파일을 같은 폴더의 .env로 복사한다.
# 이미 워커 프로세스에 설정된 환경변수가 있으면 그 값이 우선한다.
# 서버의 예약 생성 워커는 deploy/rag-generation/README.md에 안내된 키 파일을 사용한다.

# 콘텐츠 생성·검수 및 임베딩에 사용할 팀 OpenAI 키.
OPENAI_API_KEY=
# 콘텐츠 생성·검수 모델. 임베딩 모델은 색인 설정을 따른다.
ANI_MENU_MODEL=gpt-6-luna

# Firecrawl 유료 웹 검색·읽기를 쓸 때 첫 번째 키를 입력한다.
# 예비 키는 선택 사항이다. 크레딧이 소진되면 다음으로 설정된 키를 사용한다.
Firecrawl_API_KEY=
Firecrawl_API_KEY2=
Firecrawl_API_KEY3=
Firecrawl_API_KEY4=
Firecrawl_API_KEY5=
Firecrawl_API_KEY6=

# 단독 워커의 근거 DB 경로는 실행 시 --db로 지정한다.
# 벡터 검색은 --vector-db 또는 --vector-database-url-env와
# --expected-vector-database로 설정한다. 서버 접속 정보는 별도로 주입한다.
