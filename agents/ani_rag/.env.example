# RAG형 단독 실행용. 이 파일을 같은 폴더의 .env로 복사한다.
# 이미 워커 프로세스에 설정된 환경변수가 있으면 그 값이 우선한다.
# 서버의 예약 생성 워커는 deploy/rag-generation/README.md에 안내된 키 파일을 사용한다.

# 콘텐츠 생성·검수 및 임베딩에 사용할 팀 OpenAI 키.
OPENAI_API_KEY=

# 실제 .env와 같은 순서로 적었다. 아래 ANI_MENU_* 중 RAG 단독 워커가 읽는 값은
# 콘텐츠 생성·검수용 ANI_MENU_MODEL이다. 나머지는 기간형에서 복사된 설정이다.
ANI_MENU_ENV=local
ANI_MENU_DATABASE_BACKEND=sqlite
ANI_MENU_LOG_LEVEL=INFO
ANI_MENU_MODEL=gpt-6-luna
ANI_MENU_MAX_REVISION=3
ANI_MENU_REGION_POLICY=kr_first
ANI_MENU_DATABASE_URL=
ANI_MENU_DATABASE_PATH=data/ani_menu_local.sqlite3
ANI_MENU_VISUAL_LAYOUT_MODEL=gpt-6-luna
ANI_MENU_IMAGE_EDIT_ENABLED=false
ANI_MENU_IMAGE_UPSCALE_ENABLED=false
ANI_MENU_IMAGE_EDIT_MODEL=gpt-6-luna

# Firecrawl 유료 웹 검색·읽기를 쓸 때 첫 번째 키를 입력한다.
# 예비 키는 선택 사항이다. 크레딧이 소진되면 다음으로 설정된 키를 사용한다.
Firecrawl_API_KEY=
Firecrawl_API_KEY2=
Firecrawl_API_KEY3=
Firecrawl_API_KEY4=
Firecrawl_API_KEY5=
Firecrawl_API_KEY6=

# 단독 워커의 근거 DB 경로는 실행 시 --db로 지정한다.
# 벡터 검색은 --vector-db 또는 --vector-database-url-env와
# --expected-vector-database로 설정한다. 서버 접속 정보는 별도로 주입한다.
