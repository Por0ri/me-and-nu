# 정보사전 DB 접속 정보 — 이 파일을 .env 로 복사하고 값을 채운다 (.env 는 레포에 안 올라감)
MENU_DICT_DB_USER=
MENU_DICT_DB_PASSWORD=

# 모델 DB(anime-db) 설정 파일 위치 — 비밀번호를 복사하지 않고 그 파일(ANIME_DB_USER · ANIME_DB_PASSWORD)을 읽는다
MODEL_DB_ENV=
# 작품 목록 폴더 (menu_works.csv · menu_work_entries.csv). 비우면 레포 맨 위의 catalog
MENU_CATALOG_DIR=

# 공공데이터포털 인증키 (영상물등급위원회 영화 등급분류 · 자체등급분류 API). 마이페이지의 일반 인증키(Decoding)
KMRB_SERVICE_KEY=

# 콘텐츠 생성 (ani_rag.content.run)
OPENAI_API_KEY=

# 영화진흥위원회 KOBIS 오픈API 키 (한국 관객 수)
KOBIS_API_KEY=
