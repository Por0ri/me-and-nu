# 기간형 단독 실행용. 이 파일을 같은 폴더의 .env로 복사한 뒤 이 폴더에서 실행한다.
# 서버의 일일 생성 워커는 deploy/daily-generation/runtime.env.example의 키 파일 경로를 사용한다.
# 유료 생성·검수에 사용할 팀 OpenAI 키를 입력한다.
OPENAI_API_KEY=

# 로컬 실행 설정
ANI_MENU_ENV=local
ANI_MENU_LOG_LEVEL=INFO
ANI_MENU_MODEL=gpt-6-luna
ANI_MENU_VISUAL_LAYOUT_MODEL=gpt-6-luna
ANI_MENU_MAX_REVISION=3
ANI_MENU_REGION_POLICY=kr_first

# 로컬은 SQLite를 쓴다. PostgreSQL을 쓸 때는 ANI_MENU_DATABASE_BACKEND를 postgresql로 바꾸고
# ANI_MENU_DATABASE_URL에 팀 서버의 PostgreSQL 접속 주소를 입력한다.
ANI_MENU_DATABASE_BACKEND=sqlite
ANI_MENU_DATABASE_PATH=data/ani_menu_local.sqlite3
ANI_MENU_DATABASE_URL=

# 현재 로컬 구성에서는 이미지 편집과 확대를 끈다.
# 편집을 켤 때는 ANI_MENU_IMAGE_EDIT_MODEL에 이미지 편집을 지원하는 모델을 지정한다.
ANI_MENU_IMAGE_EDIT_ENABLED=false
ANI_MENU_IMAGE_UPSCALE_ENABLED=false
ANI_MENU_IMAGE_EDIT_MODEL=gpt-6-luna

# 선택 설정. 아래 값은 코드 기본값과 같다.
# ANI_MENU_VISUAL_LAYOUT_ENABLED=true
# ANI_MENU_IMAGE_OCR_ENABLED=true

# 선택 설정. LangSmith 추적을 쓸 때만 활성화한다.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ani-menu-agent-local

