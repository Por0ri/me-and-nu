# 실제 키는 .env에만 작성하고 Git에 올리지 않습니다.
OPENAI_API_KEY=

# 선택: LangSmith 실행 추적
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ani-menu-agent-local

# 실행 설정
ANI_MENU_ENV=local
ANI_MENU_LOG_LEVEL=INFO
ANI_MENU_MODEL=gpt-6-luna
ANI_MENU_MAX_REVISION=3
ANI_MENU_REGION_POLICY=kr_first
ANI_MENU_DATABASE_PATH=data/ani_menu_local.sqlite3
# 팀 PostgreSQL을 사용할 때만 로컬 경로 대신 설정
# ANI_MENU_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

