# 루트 compose.yaml의 값과 동일하게 맞춥니다.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5433/me_nu
# SQL과 바인딩 값은 기본적으로 로그에 남기지 않습니다. 로컬 디버깅 시에만 true.
DATABASE_ECHO=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=me_nu
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_MAX_CONNECTIONS=20
SESSION_BACKEND=redis
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 이메일·비밀번호 개발용 endpoint는 로컬에서만 사용합니다.
ENABLE_DEV_API=true
# 로컬 Swagger에서 로그인과 CSRF 입력 없이 데모 사용자로 테스트할 때만 켭니다.
ENABLE_DEV_AUTH_BYPASS=false
SESSION_COOKIE_NAME=menu_session
SESSION_EXPIRE_MINUTES=30
SESSION_COOKIE_SECURE=false

# OAuth: keep disabled until the provider app and state-table migration are ready.
# Origins have no path/query/fragment. Use localhost consistently for local browsers.
# Empty frontend origin: callbacks return to /api/v1/auth/session for backend tests.
OAUTH_FRONTEND_ORIGIN=
OAUTH_PUBLIC_API_ORIGIN=http://localhost:8000
OAUTH_STATE_TTL_SECONDS=600
KAKAO_OAUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_OAUTH_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Provider console callback URLs:
# http://localhost:8000/api/v1/auth/login/kakao/callback
# http://localhost:8000/api/v1/auth/login/naver/callback
# When a frontend is connected, include OAUTH_FRONTEND_ORIGIN in FRONTEND_ORIGINS.
# Secrets belong in backend/.env or server environment variables, never NEXT_PUBLIC_*.
# Setup and pending decisions: docs/OAUTH_T02_1_SETUP.md
