# 루트 compose.yaml의 값과 동일하게 맞춥니다.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5433/me_nu
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 이메일·비밀번호 개발용 endpoint는 로컬에서만 사용합니다.
ENABLE_DEV_API=true
# 로컬 Swagger에서 로그인과 CSRF 입력 없이 데모 사용자로 테스트할 때만 켭니다.
ENABLE_DEV_AUTH_BYPASS=false
SESSION_COOKIE_NAME=menu_session
SESSION_EXPIRE_MINUTES=30
SESSION_COOKIE_SECURE=false
