# Run python worker/setup_local.py to create worker/.env with random credentials.
# Existing Flower credentials are preserved; a missing jobs password is appended.
# This example deliberately has no usable credentials. Use 64 hex characters for
# CONTENT_JOB_DB_PASSWORD; changing it does not rotate an initialized DB password.
FLOWER_BASIC_AUTH=
FLOWER_PORT=5555
REDIS_TASKS_PORT=6380
ANIME_REDIS_PORT=6381
CELERY_BEAT_INTERVAL_SECONDS=30
CONTENT_JOB_DB_PASSWORD=

# Only used with the optional compose.discovery.yaml overlay.
ANIME_DISCOVERY_ROUTES=prtimes_rss:news
ANIME_DISCOVERY_INTERVAL_SECONDS=900
ANIME_DISCOVERY_LIMIT=5
