# Vercel의 Preview/Production 환경에 서로 다른 값을 등록해 보세요.
NEXT_PUBLIC_DEPLOY_ENV=local

# 로컬에서는 프론트와 백엔드 호스트명을 localhost로 통일하세요.
# FastAPI를 배포한 뒤에는 예: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# /consumer 화면 데이터: mock(기본 시연) 또는 api(로컬 FastAPI 연동)
NEXT_PUBLIC_CONSUMER_DATA_MODE=mock

# api 모드의 로컬 로그인→온보딩→홈 시연. 실제 OAuth가 아니며 양쪽 주소가 loopback일 때만 허용.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO_LOGIN=false
