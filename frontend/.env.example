# Vercel의 Preview/Production 환경에 서로 다른 값을 등록해 보세요.
NEXT_PUBLIC_DEPLOY_ENV=local

# 로컬에서는 프론트와 백엔드 호스트명을 localhost로 통일하세요.
# FastAPI를 배포한 뒤에는 예: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# /consumer 화면 데이터: mock(기본 시연) 또는 api(로컬 FastAPI 연동)
NEXT_PUBLIC_CONSUMER_DATA_MODE=mock

# api 모드의 로컬 로그인→온보딩→홈 시연. 실제 OAuth가 아니며 양쪽 주소가 loopback일 때만 허용.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO_LOGIN=false

# Pivot staging: https://test.me-nu.kr with NEXT_PUBLIC_API_BASE_URL=https://api.test.me-nu.kr.
# Separate backend-labs Preview: https://labs.me-nu.kr with NEXT_PUBLIC_API_BASE_URL=https://api.labs.me-nu.kr.
# Set the labs API value only for the backend-labs Preview branch, then rebuild.
# NEXT_PUBLIC values are embedded at build time; changing them does not update existing builds.
# Only these exact HTTPS pairs are allowed; mixed pairs and arbitrary Preview hosts are rejected.
# Local OAuth/API testing additionally requires this flag and matching loopback hostnames
# and schemes (for example http://localhost:3000 -> http://localhost:8000).
# New-account onboarding submission is not enabled by this integration.
NEXT_PUBLIC_PIVOT_ENABLE_LOCAL_API=false

# Server-only /pivot/demo gate. Local next dev needs no opt-in.
# A production build allows demos only when VERCEL_ENV=preview AND this is true.
# Configure only for an approved Preview. Production always rejects demos.
# Never rename this to NEXT_PUBLIC_ or put credentials in this example.
PIVOT_DEMO_ENABLED=false
